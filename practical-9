#include <iostream>
using namespace std;

int main()
{
    int n = 4;

    int graph[4][4] = {
        {0, 2, 3, 0},
        {2, 0, 0, 1},
        {3, 0, 0, 4},
        {0, 1, 4, 0}
    };

    int visited[4] = {0, 0, 0, 0};

    visited[0] = 1;    

    int total = 0;

    cout << "Edges in Minimum Spanning Tree:\n";

    for (int edge = 0; edge < n - 1; edge++)
    {
        int min = 999;
        int x = 0, y = 0;

        for (int i = 0; i < n; i++)
        {
            if (visited[i] == 1)
            {
                for (int j = 0; j < n; j++)
                {
                    if (visited[j] == 0 && graph[i][j] != 0)
                    {
                        if (graph[i][j] < min)
                        {
                            min = graph[i][j];
                            x = i;
                            y = j;
                        }
                    }
                }
            }
        }

        cout << char('A' + x) << " - "
             << char('A' + y)
             << " = " << min << endl;

        total = total + min;
        visited[y] = 1;
    }

    cout << "Minimum Cost = " << total << endl;

    return 0;
}
